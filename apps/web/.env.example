# The FastAPI backend this app's server components and route handlers read.
# Request time, not build time, so one build serves every environment.
API_BASE_URL=http://localhost:8000

# The site's own public address. Used for canonical URLs, the sitemap and the
# structured data -- all three are wrong if this is wrong, and all three are
# read by machines that do not report the mistake.
SITE_URL=http://localhost:3002
